PORT=3000
# IP de esta mÃ¡quina en la red local (se usa para CORS y mensajes de arranque)
IP=192.168.18.127
# Opcional: orÃ­genes extra separados por coma
# ALLOWED_ORIGINS=http://192.168.50.152:3000,http://localhost:3000

# MongoDB (elige una)
# Local:
DBLOCAL=mongodb://localhost:27017/lasgambusinas
# O Atlas / otro servidor:
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/lasgambusinas?retryWrites=true&w=majority

NODE_ENV=development
JWT_SECRET=cambia-este-secreto-en-produccion

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Facturación electrónica (src/facturacion)
FACTURACION_HABILITADA=false
FACTURACION_PROVEEDOR=mock
# SEE del contribuyente. Certificados en /certs (gitignored). No activar sunat hasta existir sunatDirecto.js.
# Beta pública: RUC 20000000001, usuario MODDATOS, clave moddatos, certificado demo de Greenter.
SUNAT_AMBIENTE=beta
CERT_PATH=
CERT_PASSWORD=
SUNAT_RUC=20000000001
SUNAT_SOL_USUARIO=MODDATOS
SUNAT_SOL_CLAVE=moddatos
# Beta: https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# Producción: https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_BILL_SERVICE_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
FACTURACION_WORKER=true
FACTURACION_LIMITE_BOLETA_ANONIMA=700
FACTURACION_PLAZO_ENVIO_DIAS=3
IGV_PORCENTAJE=10.5
FACTURACION_AFECTACION_CORTESIA=15
FACTURACION_UBIGEO=
FACTURACION_COD_ESTABLECIMIENTO=0000
FACTURACION_REINTENTOS=10
FACTURACION_BACKOFF_MS=60000
FACTURACION_TIMEOUT_ENCOLAR_MS=100
FACTURACION_IMPRESORA=
FACTURACION_SIRE_SUFIJO=00140100001111
